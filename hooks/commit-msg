#!/bin/bash

COMMIT_MSG=$(cat "$1")
PATTERN="^(feat|fix|docs|chore|refactor|test|style)(\(.+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo "❌ ERREUR : Message de commit non conforme à la convention Conventional Commits."
  echo "   Format attendu : type(scope): description"
  echo "   Types autorisés : feat, fix, docs, chore, refactor, test, style"
  echo "   Votre message : '$COMMIT_MSG'"
  exit 1
fi

echo "✅ Message de commit conforme."
exit 0
